<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>uSync.TreeBranch</PackageId>
		<Title>uSync TreeBranch</Title>
		<Description>[Experimental] Makes an Umbraco development site aware of the git checkout it runs from: a database, ports and shared media per git worktree, and a uSync import when the commit changes.</Description>
		<PackageTags>umbraco-marketplace uSync git worktree</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<InternalsVisibleTo Include="uSync.TreeBranch.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="LibGit2Sharp" Version="0.32.0" />
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="17.3.0" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="17.3.0" />
		<PackageReference Include="Umbraco.Cms.Persistence.Sqlite" Version="17.3.0" />
		<PackageReference Include="Umbraco.Cms.Persistence.SqlServer" Version="17.3.0" />
		<PackageReference Include="uSync.BackOffice" Version="17.5.1" />

	</ItemGroup>

</Project>
